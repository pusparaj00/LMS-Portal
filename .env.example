# Copy to .env and fill every value. Nothing here has a working default.
POSTGRES_PASSWORD=
LMS_API_DB_PASSWORD=
LMS_MASTERY_DB_PASSWORD=
REDIS_PASSWORD=
JWT_SECRET=
MASTERY_SERVICE_TOKEN=
LMS_CHAT_DB_PASSWORD=


# LLM adapter (TR-A-04). "stub" returns a canned reply and needs no key; "gemini" calls Google AI Studio.
LLM_PROVIDER=stub
LLM_MODEL=stub
LLM_TIMEOUT_S=30
LLM_MAX_RETRIES=2
LLM_TEMPERATURE=0.1
# Only the api service receives this key. Never commit it.
GEMINI_API_KEY=
# Providers tried in order when the primary one fails or is out of quota. Leave empty to use only the primary.
LLM_FALLBACK=
GROQCLOUD_API_KEY=
DEEPSEEK_API_KEY=
OPENAI_API_KEY=
