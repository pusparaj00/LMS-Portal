# Copy to .env and fill every value. Nothing here has a working default.
POSTGRES_PASSWORD=
LMS_API_DB_PASSWORD=
LMS_MASTERY_DB_PASSWORD=
REDIS_PASSWORD=
JWT_SECRET=
MASTERY_SERVICE_TOKEN=
LMS_CHAT_DB_PASSWORD=


# LLM adapter (TR-A-04). "stub" returns a canned reply and needs no key; "gemini" and "gemini_pro" call Google AI
# Studio with GEMINI_API_KEY and GEMINI_PRO_API_KEY; groq, openrouter, mistral and openai are also accepted.
LLM_PROVIDER=stub
LLM_MODEL=stub
LLM_TIMEOUT_S=12
LLM_BUDGET_S=20
LLM_MAX_RETRIES=2
LLM_TEMPERATURE=0.1
# Only the api service receives this key. Never commit it.
GEMINI_API_KEY=
GEMINI_PRO_API_KEY=
# Default model for a "gemini" or "gemini_pro" fallback entry written without a model.
LLM_MODEL_GEMINI=gemini-3.5-flash-lite
LLM_MODEL_GEMINI_PRO=gemini-3.5-flash-lite
# Tried in order when the primary fails or is out of quota; each entry is `provider` or `provider:model`, e.g.
# gemini_pro:gemini-3.1-pro-preview,gemini,groq,openrouter,mistral,openai. Leave empty to use only the primary.
# A provider that rejects its key or runs out of quota is tried last for a while (cooldown) instead of first.
LLM_FALLBACK=
GROQCLOUD_API_KEY=
# A model served locally (Ollama, vLLM, LM Studio): any OpenAI-compatible server. Use it as LLM_PROVIDER=local, or add
# `local` to LLM_FALLBACK. No key is needed. From the api container, the host machine is host.docker.internal.
# Local models are slower: raise LLM_TIMEOUT_S and LLM_BUDGET_S.
LOCAL_LLM_BASE_URL=
LOCAL_LLM_API_KEY=
LLM_MODEL_LOCAL=
OPENAI_API_KEY=
MISTRAL_API_KEY=
# Optional: passwords for the demo accounts that `python -m app.seed` creates. If empty, random ones are printed once.
DEMO_STUDENT_PASSWORD=
DEMO_INSTRUCTOR_PASSWORD=
OPENROUTER_API_KEY=
