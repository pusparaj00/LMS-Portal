  {
    "title": "Sum the valid integers",
    "statement": "Read a line of tokens. Print the sum of the tokens that are valid integers, ignoring the others (for example `3.5` or `x`).",
    "concepts": [
      {
        "name": "exceptions",
        "weight": 0.8
      },
      {
        "name": "loops",
        "weight": 0.2
      }
    ],
    "difficulty_b": 0.6,
    "discrimination_a": 1.2,
    "reference_solution": "total = 0\nfor token in input().split():\n    try:\n        total += int(token)\n    except ValueError:\n        pass\nprint(total)\n",
    "tests": [
      {
        "input": "1 2 3\n",
        "expected": "6\n",
        "hidden": false,
        "category": "basic"
      },
      {
        "input": "10 x 20\n",
        "expected": "30\n",
        "hidden": false,
        "category": "invalid_token"
      },
      {
        "input": "a b c\n",
        "expected": "0\n",
        "hidden": true,
        "category": "all_invalid"
      },
      {
        "input": "-5 3.5 8\n",
        "expected": "3\n",
        "hidden": true,
        "category": "invalid_token"
      },
      {
        "input": "\n",
        "expected": "0\n",
        "hidden": true,
