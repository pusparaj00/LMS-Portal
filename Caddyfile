# TR-O-01, TR-O-07. SITE_ADDRESS is the server's IP address. `tls internal` signs the certificate with Caddy's own
# authority, so browsers warn until that root (in the caddy_data volume) is installed or a domain name and a public
# certificate replace it. Caddy also redirects plain HTTP to HTTPS, and sets X-Forwarded-For to the address it saw,
# discarding any value the client sent (TR-O-03). A browser sends no server name when it connects to an IP address, so
# default_sni names the certificate to use then. HSTS has no includeSubDomains or preload: the site is an IP address, and
# the policy should reach only this host. The CSP allows only this origin; styles need 'unsafe-inline' because React sets
# style attributes, and the code editor starts its web workers from blob: URLs. Nothing is loaded from another host.
{
	default_sni {$SITE_ADDRESS}
}

https://{$SITE_ADDRESS} {
	tls internal
	encode gzip
	header {
		X-Content-Type-Options nosniff
		X-Frame-Options DENY
		Referrer-Policy strict-origin-when-cross-origin
		Permissions-Policy "camera=(), microphone=(), geolocation=()"
		Strict-Transport-Security "max-age=31536000"
		Content-Security-Policy "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob:; font-src 'self' data:; connect-src 'self'; worker-src 'self' blob:; object-src 'none'; base-uri 'self'; form-action 'self'; frame-ancestors 'none'"
		-Server
	}
	reverse_proxy frontend:8080
}
